<?xml version="1.0" encoding="utf-8"?>
<!-- Weather now: the hero card's 'right now' panel on its own colours and weather. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_now_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_now_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/widget_now_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp"
            android:text="@string/widget_now_preview_temperature" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_now_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/widget_now_preview_label" />

            <TextView
                android:id="@+id/widget_now_feels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_now_preview_feels" />

            <TextView
                android:id="@+id/widget_now_wind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_now_preview_wind" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
